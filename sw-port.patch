new file mode 100644
index 0000000..cdbe608
--- /dev/null
+++ b/games/botw/scripts/romfs_damage.py
@@ -0,0 +1,77 @@
+#!/usr/bin/env python3
+"""The one RomFS damage the BOTW build tolerates.
+
+Some copies of the 1.9.0 update carry one damaged 1 MiB region; every bad IVFC data block lies inside
+Event_BGM_CompleteMasterSword.bfstm (a music stream). A merge whose only bad blocks come from the update and lie inside
+that file is accepted with a warning. Any other bad block (another file, RomFS metadata, the IVFC hash tree or the base
+game) stops the build.
+"""
+from dataclasses import dataclass, field
+import re
+
+ALLOWED = 'Sound/Resource/Stream/Event_BGM_CompleteMasterSword.bfstm'
+KNOWN_DAMAGE_MESSAGE = '更新文件有一处已知损坏，只影响拔出大师之剑时的一段背景音乐'
+METADATA = '<RomFS metadata>'
+
+
+@dataclass
+class DamageVerdict:
+    ok: bool
+    known: bool
+    offending: list = field(default_factory=list)
+
+
+@dataclass
+class BadBlocks:
+    data: list            # (start, end) RomFS offsets of bad data blocks read from the update
+    base_data: list       # the same, read from the base game
+    hash_tree: bool       # a block of an upper IVFC level (the hash tree) failed
+
+
+def check_damage(bad_ranges, files):
+    """bad_ranges: (start, end) RomFS offsets; files: (path, offset, size). Only damage inside ALLOWED is tolerated."""
+    offending, known = [], False
+    for start, end in bad_ranges:
+        hit = [path for path, offset, size in files if start < offset + size and offset < end]
+        if not hit:
+            hit = [METADATA]
+        for path in hit:
+            if path == ALLOWED:
+                known = True
+            elif path not in offending:
+                offending.append(path)
+    return DamageVerdict(ok=not offending, known=known and not offending, offending=offending)
+
+
+_LINE = re.compile(r'MNG_BADBLOCK data_ofs=([0-9a-f]+) ofs=([0-9a-f]+) len=([0-9a-f]+) src=(\w+)')
+_LEVEL5 = re.compile(r'Level 5 \((?:GOOD|FAIL)\):\s*\n\s*Data Offset:\s*0x([0-9a-fA-F]+)')
+
+
+def parse_bad_blocks(log):
+    """The MNG_BADBLOCK lines of the pinned hactool (build_app.build_hactool). Level 5 is the RomFS data itself."""
+    level5 = _LEVEL5.search(log)
+    data_start = int(level5.group(1), 16) if level5 else None
+    blocks = BadBlocks(data=[], base_data=[], hash_tree=False)
+    for m in _LINE.finditer(log):
+        data_ofs, ofs, size = (int(m.group(i), 16) for i in (1, 2, 3))
+        if data_start is None or data_ofs != data_start:
+            blocks.hash_tree = True
+        elif m.group(4) == 'PATCH':
+            blocks.data.append((ofs, ofs + size))
+        else:
+            blocks.base_data.append((ofs, ofs + size))
+    return blocks
+
+
+def judge(log, files):
+    """The verdict for a merge log; files as in check_damage. Base-game damage and hash-tree damage are never tolerated."""
+    blocks = parse_bad_blocks(log)
+    verdict = check_damage(blocks.data, files)
+    if blocks.base_data:
+        base = check_damage(blocks.base_data, files)
+        verdict.offending += [f'{p} (base game)' for p in base.offending + ([ALLOWED] if base.known else [])]
+    if blocks.hash_tree:
+        verdict.offending.append('<IVFC hash tree>')
+    verdict.ok = not verdict.offending
+    verdict.known = verdict.known and verdict.ok
+    return verdict
