index 0000000..7f8b93e
--- /dev/null
+++ b/games/botw/scripts/build_botw.py
@@ -0,0 +1,227 @@
+#!/usr/bin/env python3
+"""Build one native macOS app of The Legend of Zelda: Breath of the Wild 1.9.0 (experimental).
+
+Called by build_app.py --title botw. It prints the same "n/4 step" progress lines as the TOTK build, so the launcher
+shows both the same way. The work folder holds a copy of games/totk (the shared runtime) with BOTW's generated data
+in it (extracted/v190, rewritten/v190, build/v190), separate from any TOTK work folder.
+"""
+import argparse
+import json
+import os
+from pathlib import Path
+import plistlib
+import shutil
+import subprocess
+import sys
+import time
+
+HERE = Path(__file__).resolve().parent
+REPO = HERE.parents[2]
+sys.path.insert(0, str(REPO))
+import build_app as B  # noqa: E402
+
+VERSION = 'v190'
+INFO = json.loads((HERE.parent / 'versions.json').read_text())
+EXPECTED = INFO['versions'][VERSION]
+APP_NAME = 'Breath of the Wild'
+BUNDLE_ID = 'org.macnativegames.botw'
+EXECUTABLE = 'BOTW'
+
+
+def parse_args(argv):
+    ap = argparse.ArgumentParser(prog='build_app.py --title botw',
+                                 description='Build one native macOS app from BOTW (base NSP) and its 1.9.0 update NSP.')
+    ap.add_argument('game', type=Path, help='the base game NSP')
+    ap.add_argument('--update', type=Path, help='the 1.9.0 update NSP (required)')
+    ap.add_argument('-k', '--keys', type=Path, required=True, help='your prod.keys')
+    ap.add_argument('-o', '--out', type=Path, help=f'the app to write (default: "{APP_NAME}.app" next to the game file)')
+    ap.add_argument('--work', type=Path, help='work folder (default: BOTW_build next to the game file)')
+    fonts = ap.add_mutually_exclusive_group()
+    fonts.add_argument('--firmware', type=Path, help='unpacked firmware NCA directory providing the shared fonts')
+    fonts.add_argument('--shared-fonts', type=Path, help='previously extracted shared-font directory')
+    args = ap.parse_args(argv)
+    if not args.update:
+        raise SystemExit('BOTW needs the 1.9.0 update: pass --update <update NSP> (the base game alone is not supported)')
+    return args
+
+
+def step_code(tree, update, keys, env, logs):
+    py = tree / '.venv/bin/python'
+    exefs = tree / f'extracted/{VERSION}/exefs'
+    want = EXPECTED['exefs_sha256']
+    if not all((exefs / n).is_file() and B.sha256(exefs / n) == h for n, h in want.items()):
+        B.say('1/4 code: extracting the ExeFS from the update')
+        if exefs.exists():
+            shutil.rmtree(exefs)
+        B.run([py, HERE / 'extract_exefs.py', update, '--keys', keys, '--update', '--output', exefs],
+              logs / 'extract_exefs-botw.log', cwd=tree)
+    for n, h in want.items():
+        if not (exefs / n).is_file() or B.sha256(exefs / n) != h:
+            raise B.BuildError(f'unsupported BOTW version: ExeFS {n} is not 1.9.0 (only 1.9.0 is supported)')
+    if not (tree / f'extracted/{VERSION}/elf/main-inventory.json').exists():
+        B.run([py, 'scripts/prepare_modules.py', exefs, '--output', tree / f'extracted/{VERSION}/elf'],
+              logs / 'prepare_modules-botw.log', cwd=tree)
+    out = tree / f'rewritten/{VERSION}'
+    out.mkdir(parents=True, exist_ok=True)
+    for name in ('sdk', 'subsdk0', 'main'):
+        image, h = out / f'{name}.patched.bin', EXPECTED['rewritten_sha256'][f'{name}.patched.bin']
+        if image.exists() and B.sha256(image) == h:
+            continue
+        B.say(f'1/4 code: rewriting {name} for Apple silicon' + (' (the big one: about a minute)' if name == 'main' else ''))
+        B.run([py, 'third_party/d2r/patch_nso.py', exefs / name, out, name], logs / f'rewrite_{VERSION}_{name}.log', cwd=tree,
+              env=dict(env, DM_RULESET='native', DM_PRIVATE_GATES='0'))
+        B.check(f'rewritten {name}', B.sha256(image), h)
+    report = dict(format=1, status='pass', rom_version=VERSION, scope='hash match with the BOTW 1.9.0 rewrite',
+                  module_file_sha256={**{f'extracted/{VERSION}/exefs/{n}': want[n] for n in ('main', 'sdk', 'subsdk0')},
+                                      **{f'rewritten/{VERSION}/{n}.patched.bin': EXPECTED['rewritten_sha256'][f'{n}.patched.bin']
+                                         for n in ('main', 'sdk', 'subsdk0')}})
+    path = tree / f'analysis/{VERSION}-port/phase12-validation.json'
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(report, indent=2) + '\n')
+
+
+def step_data(tree, game, update, keys, logs, firmware, shared_fonts):
+    py = tree / '.venv/bin/python'
+    folder = tree / f'extracted/{VERSION}/romfs'
+    index = folder / 'index.json'
+    valid = False
+    if index.is_file() and (folder / 'romfs.bin').is_file():
+        try:
+            report = json.loads(index.read_text())
+            valid = report.get('status') == 'pass' and (folder / 'romfs.bin').stat().st_size == report['romfs_size']
+        except (ValueError, KeyError):
+            pass
+    if not valid:
+        hactool = B.build_hactool(tree, logs)
+        if folder.exists():
+            shutil.rmtree(folder)
+        B.say('2/4 data: merging the base game and the 1.9.0 update, verifying every IVFC block (a few minutes)')
+        log = logs / 'update-romfs-botw.log'
+        try:
+            B.run([py, HERE / 'extract_update_romfs.py', game, update, '--keys', keys, '--hactool', hactool, '--output', folder],
+                  log, cwd=tree)
+        except B.BuildError:
+            reason = next((l for l in reversed(log.read_text(errors='replace').splitlines()) if 'RomFS damage' in l or 'failed' in l), '')
+            raise B.BuildError(f'the game data did not verify. {reason.strip()}') from None
+        for line in log.read_text(errors='replace').splitlines():
+            if line.startswith('WARNING: '):
+                B.say('2/4 data: ' + line[len('WARNING: '):])
+    report = json.loads(index.read_text())
+    if 'data damage only inside' in report.get('integrity', ''):
+        B.say('2/4 data: ' + 'known damage tolerated: ' + report['integrity'])
+    fonts = tree / 'extracted/firmware/shared-fonts'
+    if not B.fonts_valid(fonts):
+        if shared_fonts:
+            fonts.mkdir(parents=True, exist_ok=True)
+            report = B.font_report(shared_fonts)
+            for f in report['fonts']:
+                name = f"{f['type']}-{f['name']}.bfttf"
+                shutil.copy2(shared_fonts / name, fonts / name)
+            (fonts / 'manifest.json').write_text(json.dumps(report, indent=2) + '\n')
+        else:
+            if not firmware:
+                raise B.BuildError('NSP needs --firmware or --shared-fonts because no valid shared fonts are cached')
+            B.say('2/4 data: extracting the system shared fonts')
+            if fonts.exists():
+                shutil.rmtree(fonts)
+            B.run([py, 'scripts/extract_shared_fonts.py', '--keys', keys, '--firmware', firmware, '--output', fonts],
+                  logs / 'shared_fonts.log', cwd=tree)
+        B.validate_fonts(fonts)
+
+
+def step_shaders(tree, logs):
+    # BOTW has no prepared startup shader seed yet: shaders are translated and cached on first use.
+    if not (tree / 'build/spirv-cross/spirv-cross').exists():
+        B.say('3/4 shaders: building SPIRV-Cross with clang')
+        B.build_spirv_cross(tree, logs)
+    translator = tree / 'prebuilt/macos-arm64/totk_xlate'
+    if not translator.is_file() or B.sha256(translator) != (translator.parent / 'totk_xlate.sha256').read_text().strip():
+        raise B.BuildError(f'{translator}: not the shader translator this repository ships')
+    B.say('3/4 shaders: the shader translator is ready (BOTW shaders are translated on first use)')
+
+
+def step_binary(tree, game, keys, env, logs):
+    B.say('4/4 app: building the game binary and the launcher')
+    B.run(['make', f'runtime-{VERSION}'], logs / 'runtime-botw.log', cwd=tree, env=env)
+    B.run(['xcrun', 'clang', '-fobjc-arc', '-O2', '-Wall', '-Ithird_party/d2r_gfx/gfx/nvn', '-Iruntime', f'-DTOTK_GAME_{VERSION.upper()}=1',
+           'app/launcher.m', 'runtime/romfs_mods.c', '-framework', 'AppKit', '-o', 'build/app-launcher-botw'], logs / 'launcher-botw.log', cwd=tree, env=env)
+    if not (tree / 'build/AppIcon-botw.icns').exists():
+        try:
+            B.run([tree / '.venv/bin/python', 'scripts/extract_app_icon.py', game, '--keys', keys, '--output', 'build/AppIcon-botw.icns'],
+                  logs / 'app_icon-botw.log', cwd=tree)
+        except B.BuildError as e:
+            B.say(f'   no app icon, the app gets the default one ({str(e).splitlines()[0]})')
+
+
+def step_app(tree, out, logs):
+    tmp = out.with_name(out.name + '.partial')
+    if tmp.exists():
+        shutil.rmtree(tmp)
+    res = tmp / 'Contents/Resources/totk'
+    B.clone(tree / f'build/totk-native-{VERSION}', res / 'build/botw-native')
+    for rel in ('build/pso_manifest.tsv', 'build/spirv-cross/spirv-cross',
+                f'rewritten/{VERSION}/main.patched.bin', f'rewritten/{VERSION}/sdk.patched.bin', f'rewritten/{VERSION}/subsdk0.patched.bin',
+                f'extracted/{VERSION}/romfs/romfs.bin', f'extracted/{VERSION}/romfs/runtime-index.bin'):
+        B.clone(tree / rel, res / rel)
+    B.clone(tree / 'prebuilt/macos-arm64/totk_xlate', res / 'build/shader-service/totk_xlate')
+    B.copy_tree(tree / 'extracted/firmware/shared-fonts', res / 'extracted/firmware/shared-fonts')
+    B.clone(tree / 'build/app-launcher-botw', tmp / f'Contents/MacOS/{EXECUTABLE}')
+    info = dict(CFBundleDevelopmentRegion='en', CFBundleExecutable=EXECUTABLE, CFBundleIdentifier=BUNDLE_ID, CFBundleName=APP_NAME,
+                CFBundleDisplayName=APP_NAME, CFBundlePackageType='APPL', CFBundleShortVersionString=EXPECTED['display_version'],
+                CFBundleVersion='1', LSMinimumSystemVersion='26.0', NSHighResolutionCapable=True,
+                LSApplicationCategoryType='public.app-category.action-games', LSSupportsGameMode=True,
+                GCSupportsControllerUserInteraction=True, **B.APP_INFO_EXTRA)
+    icon = tree / 'build/AppIcon-botw.icns'
+    if icon.exists():
+        B.clone(icon, tmp / 'Contents/Resources/AppIcon.icns')
+        info['CFBundleIconFile'] = 'AppIcon'
+    (tmp / 'Contents/Info.plist').write_bytes(plistlib.dumps(info))
+    (tmp / 'Contents/PkgInfo').write_bytes(b'APPL????')
+    B.sign_app(tmp, logs)
+    old_binary = out / 'Contents/Resources/totk/build/botw-native'
+    while old_binary.is_file():
+        processes = subprocess.run(['ps', '-axo', 'comm='], capture_output=True, text=True, check=True).stdout.splitlines()
+        if str(old_binary.resolve()) not in (p.strip() for p in processes):
+            break
+        B.say('4/4 app: replacement is ready; waiting for the running game to close before updating it')
+        time.sleep(5)
+    if out.exists():
+        shutil.rmtree(out)
+    tmp.rename(out)
+
+
+def main(args):
+    game, keys, update = (p.expanduser().resolve() for p in (args.game, args.keys, args.update))
+    for p in (game, keys, update):
+        if not p.is_file():
+            raise B.BuildError(f'no such file: {p}')
+    if B.input_kind(game) != 'nsp' or B.input_kind(update) != 'nsp':
+        raise B.BuildError('BOTW needs the base game NSP and the 1.9.0 update NSP')
+    out = args.out.expanduser().resolve() if args.out else game.parent / f'{APP_NAME}.app'
+    work = args.work.expanduser().resolve() if args.work else game.parent / 'BOTW_build'
+    if out.suffix != '.app':
+        raise B.BuildError(f'the output must end in .app: {out}')
+    firmware = args.firmware.expanduser().resolve() if args.firmware else None
+    shared_fonts = args.shared_fonts.expanduser().resolve() if args.shared_fonts else None
+    py = B.prerequisites(args)
+    free = shutil.disk_usage(work.parent if work.parent.exists() else game.parent).free / 2**30
+    B.say(f'work folder {work} ({free:.0f} GB free on its volume)')
+    if free < 35 and not (work / f'totk/extracted/{VERSION}/romfs/romfs.bin').exists():
+        raise B.BuildError('needs about 35 GB free for a fresh BOTW build')
+    logs = work / 'logs'
+    env = dict(os.environ, PATH=os.pathsep.join(B.TOOL_PATHS + [os.environ.get('PATH', '/usr/bin:/bin:/usr/sbin:/sbin')]))
+    t0 = time.time()
+    tree = B.prepare_work(work, py, logs)
+    step_code(tree, update, keys, env, logs)
+    step_data(tree, game, update, keys, logs, firmware, shared_fonts)
+    step_shaders(tree, logs)
+    step_binary(tree, game, keys, env, logs)
+    B.say(f'4/4 app: assembling {out}')
+    step_app(tree, out, logs)
+    B.run([B.LSREGISTER, '-f', out], logs / 'register-app-botw.log')
+    B.say('4/4 app: macOS checks the new app once (a few minutes)')
+    r = subprocess.run([out / f'Contents/MacOS/{EXECUTABLE}', '--check'], capture_output=True, text=True, timeout=1800)
+    if r.returncode:
+        raise B.BuildError(f'the app does not start: {(r.stdout + r.stderr).strip()}')
+    B.say(f'done in {(time.time() - t0) / 60:.0f} min: {out}')
+    return 0
