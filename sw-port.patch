+/* RomFS mods manifest (games/totk/runtime/romfs_mods.c), without game files. */
+#include "../games/totk/runtime/romfs_mods.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static int failed;
+#define CHECK(c) do { if (!(c)) { printf("FAIL %s:%d %s\n", __FILE__, __LINE__, #c); failed++; } } while (0)
+
+static const char *GAME[] = {"Actor/A.bin", "Pack/Bootup.pack", "UI/Font.bfarc"};
+static int64_t find_index(const char *path, void *ctx) { (void)ctx; for (int i = 0; i < 3; i++) if (!strcmp(path, GAME[i])) return i; return -1; }
+static int builtin_none(uint64_t index, void *ctx) { (void)index; (void)ctx; return 0; }
+static int builtin_pack(uint64_t index, void *ctx) { (void)ctx; return index == 1; }
+static char logbuf[4096];
+static void log_line(const char *line, void *ctx) { (void)ctx; strncat(logbuf, line, sizeof logbuf - strlen(logbuf) - 2); strcat(logbuf, "\n"); }
+
+static void write_file(const char *path, size_t n) { FILE *f = fopen(path, "wb"); for (size_t i = 0; i < n; i++) fputc('x', f); fclose(f); }
+
+int main(void) {
+    char dir[] = "/tmp/romfs-mods-XXXXXX"; if (!mkdtemp(dir)) return 1;
+    char a[256], b[256], text[2048], err[256];
+    snprintf(a, sizeof a, "%s/a.bin", dir); write_file(a, 10);
+    snprintf(b, sizeof b, "%s/b.bin", dir); write_file(b, 20);
+    mods_t m;
+
+    /* test_parse_and_find */
+    snprintf(text, sizeof text, "Actor/A.bin\t%s\t10\nPack/Bootup.pack\t%s\t20\nNew/File.txt\t%s\t10\n", a, b, a);
+    CHECK(mods_parse(text, strlen(text), &m, err, sizeof err) == 0);
+    CHECK(m.n == 3);
+    CHECK(mods_find(&m, "Actor/A.bin") && mods_find(&m, "Actor/A.bin")->size == 10);
+    CHECK(mods_find(&m, "Pack/Bootup.pack") && !strcmp(mods_find(&m, "Pack/Bootup.pack")->host, b));
+    CHECK(mods_find(&m, "Nope") == NULL);
+
+    /* test_unknown_path_is_skipped and test_builtin_wins */
+    mods_bound_t bound; logbuf[0] = 0;
+    CHECK(mods_bind(&m, find_index, builtin_pack, NULL, log_line, NULL, &bound, err, sizeof err) == 0);
+    CHECK(bound.n == 1 && bound.v[0].index == 0 && bound.v[0].size == 10 && bound.v[0].fd >= 0);
+    CHECK(strstr(logbuf, "mod: New/File.txt not in the game (new files are not supported)") != NULL);
+    CHECK(strstr(logbuf, "mod: Pack/Bootup.pack ignored (built-in fix)") != NULL);
+    CHECK(mods_bound_find(&bound, 0) == &bound.v[0] && mods_bound_find(&bound, 2) == NULL);
+    mods_bound_free(&bound); mods_free(&m);
+
+    /* test_size_mismatch_fails_at_start */
+    snprintf(text, sizeof text, "Actor/A.bin\t%s\t11\n", a);
+    CHECK(mods_parse(text, strlen(text), &m, err, sizeof err) == 0);
+    CHECK(mods_bind(&m, find_index, builtin_none, NULL, log_line, NULL, &bound, err, sizeof err) != 0);
+    CHECK(strstr(err, "mod file changed since the launcher listed it: Actor/A.bin") != NULL);
+    mods_free(&m);
+
+    /* test_bad_line_fails */
+    snprintf(text, sizeof text, "Actor/A.bin\t%s\t10\nBroken line\n", a);
+    CHECK(mods_parse(text, strlen(text), &m, err, sizeof err) != 0);
+    CHECK(strstr(err, "line 2") != NULL);
+
+    /* test_duplicate_path_last_wins */
+    snprintf(text, sizeof text, "Actor/A.bin\t%s\t10\nActor/A.bin\t%s\t20\n", a, b);
+    CHECK(mods_parse(text, strlen(text), &m, err, sizeof err) == 0);
+    CHECK(m.n == 1 && mods_find(&m, "Actor/A.bin")->size == 20);
+    mods_free(&m);
+
+    /* paths must stay inside the RomFS */
+    snprintf(text, sizeof text, "../etc/passwd\t%s\t10\n", a);
+    CHECK(mods_parse(text, strlen(text), &m, err, sizeof err) != 0);
+
+    /* test_manifest_check (the in-app launcher's check before starting the game) */
+    snprintf(text, sizeof text, "Actor/A.bin\t%s\t10\nNew/x\t%s\t20\n", a, b);
+    CHECK(mods_manifest_check(text, strlen(text), err, sizeof err) == 0);
+    snprintf(text, sizeof text, "Actor/A.bin\t%s\t10\nNew/x\t%s\t21\n", a, b);
+    CHECK(mods_manifest_check(text, strlen(text), err, sizeof err) != 0);
+    CHECK(strstr(err, "mod file changed since the launcher listed it: New/x") != NULL);
+
+    unlink(a); unlink(b); rmdir(dir);
+    if (failed) return 1;
+    printf("romfs mods: all cases pass\n");
+    return 0;
+}
diff --git a/tests/test_romfs_mods.py b/tests/test_romfs_mods.py
new file mode 100644
index 0000000..fb1b2fe
