+++ b/tests/test_romfs_mods.py
@@ -0,0 +1,27 @@
+"""Compile and exercise the RomFS mods manifest code without game files."""
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class RomfsMods(unittest.TestCase):
+    def test_manifest(self):
+        compiler = shutil.which('cc') or shutil.which('clang')
+        if not compiler:
+            self.skipTest('A C compiler is required')
+        with tempfile.TemporaryDirectory() as directory:
+            exe = Path(directory) / 'test-romfs-mods'
+            build = subprocess.run([compiler, '-std=c11', '-Wall', '-Wextra', '-Werror', str(ROOT / 'tests/test_romfs_mods.c'),
+                                    str(ROOT / 'games/totk/runtime/romfs_mods.c'), '-o', str(exe)], capture_output=True, text=True)
+            self.assertEqual(build.returncode, 0, build.stdout + build.stderr)
+            result = subprocess.run([str(exe)], capture_output=True, text=True)
+            self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+            self.assertIn('romfs mods: all cases pass', result.stdout)
+
+
+if __name__ == '__main__':
+    unittest.main()
