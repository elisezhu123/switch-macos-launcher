index 0000000..a36bb90
--- /dev/null
+++ b/games/botw/scripts/extract_exefs.py
@@ -0,0 +1,254 @@
+#!/usr/bin/env python3
+"""Read an XCI or NSP in place; extract and verify its base or explicitly selected update Program ExeFS.
+
+Supports NCA3, key-area or common-ticket AES-CTR, and hierarchical SHA-256 PFS0.
+Keys stay in memory. No RomFS extraction, executable launch, or network calls.
+"""
+import argparse
+import hashlib
+import json
+import struct
+import io
+from pathlib import Path
+from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
+
+
+BASE_TITLE = '01007EF00011E000'    # The Legend of Zelda: Breath of the Wild
+UPDATE_TITLE = '01007EF00011E800'  # its update; the update Program NCA keeps the base ID, its Meta NCA carries this one
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def decrypt(key, mode, data):
+    ctx = Cipher(algorithms.AES(key), mode).decryptor()
+    return ctx.update(data) + ctx.finalize()
+
+
+def read_at(f, offset, length):
+    require(0 <= offset and 0 <= length <= 512 * 1024 * 1024, 'Invalid/big read')
+    f.seek(offset)
+    data = f.read(length)
+    require(len(data) == length, 'Truncated input')
+    return data
+
+
+def hfs(f, offset, bound):
+    return partition_entries(f, offset, bound, b'HFS0', 64)
+
+
+def partition_entries(f, offset, bound, magic=b'PFS0', stride=24):
+    """Read a bounded PFS0/HFS0 table without loading its file payloads."""
+    require(bound >= 16, 'Truncated partition header')
+    hdr = read_at(f, offset, 16)
+    require(hdr[:4] == magic, f'Expected {magic.decode()}')
+    count, strings_size = struct.unpack_from('<II', hdr, 4)
+    require(count <= 4096 and strings_size <= 1024 * 1024, 'Invalid partition table')
+    size = 16 + count * stride + strings_size
+    require(size <= bound, 'Partition table out of bounds')
+    raw = read_at(f, offset, size)
+    strings = raw[16 + count * stride:]
+    entries = []
+    names = set()
+    for i in range(count):
+        off, length, nameoff = struct.unpack_from('<QQI', raw, 16 + i * stride)
+        require(nameoff < len(strings), 'Invalid partition filename offset')
+        end = strings.find(b'\0', nameoff)
+        require(end >= 0, 'Unterminated partition filename')
+        name = strings[nameoff:end].decode('utf-8')
+        require(name not in ('', '.', '..') and '/' not in name and '\\' not in name, 'Unsafe partition filename')
+        require(name not in names, 'Duplicate partition filename')
+        names.add(name)
+        require(size + off + length <= bound, 'Partition entry out of bounds')
+        entries.append((name, offset + size + off, length))
+    end = offset + size
+    for _, start, length in sorted(entries, key=lambda e: e[1]):
+        require(start >= end, 'Overlapping partition entries')
+        end = start + length
+    return entries
+
+
+def container_entries(f, size):
+    if read_at(f, 0, 4) == b'PFS0':
+        return 'nsp', partition_entries(f, 0, size)
+    require(size >= 0x138 and read_at(f, 0x100, 4) == b'HEAD', 'Expected an XCI or NSP (PFS0) game file')
+    root = struct.unpack('<Q', read_at(f, 0x130, 8))[0]
+    partitions = hfs(f, root, size - root)
+    secure = [e for e in partitions if e[0] == 'secure']
+    require(len(secure) == 1, 'Expected one XCI secure partition')
+    return 'xci', hfs(f, secure[0][1], secure[0][2])
+
+
+def load_keys(path):
+    keys = {}
+    for number, line in enumerate(path.read_text().splitlines(), 1):
+        line = line.split('#', 1)[0].strip()
+        if '=' in line:
+            name, value = line.split('=', 1)
+            try:
+                keys[name.strip().lower()] = bytes.fromhex(value.strip())
+            except ValueError:
+                raise ValueError(f'Invalid key encoding at line {number}') from None
+    return keys
+
+
+def common_tickets(f, entries):
+    """Keep encrypted title keys in memory only, as nxnative's NSP importer does.
+
+    Ticket offsets below are relative to the signed body; accept the standard RSA/ECDSA layouts.
+    A personalized ticket cannot provide a common title key and is never treated as one.
+    """
+    tickets = {}
+    bodies = {0x10000: 0x240, 0x10001: 0x140, 0x10002: 0x80,
+              0x10003: 0x240, 0x10004: 0x140, 0x10005: 0x80}
+    for name, offset, size in entries:
+        if not name.lower().endswith('.tik'):
+            continue
+        require(size >= 4, 'Truncated NSP ticket')
+        # Switch ticket signature type is little-endian: RSA2048/SHA256 = 04 00 01 00.
+        sig = struct.unpack('<I', read_at(f, offset, 4))[0]
+        require(sig in bodies, 'Unsupported NSP ticket signature type')
+        body = bodies[sig]
+        require(size >= body + 0x180, 'Truncated NSP ticket body')
+        data = read_at(f, offset + body, 0x180)
+        require(data[0x141] == 0, 'Personalized NSP tickets are unsupported; a common ticket is required')
+        rights, key = data[0x160:0x170], data[0x40:0x50]
+        require(rights not in tickets or tickets[rights] == key, 'Conflicting NSP tickets')
+        tickets[rights] = key
+    return tickets
+
+
+def read_nca_header(f, offset, size, keys):
+    require(size >= 0xc00, 'Truncated NCA header')
+    require('header_key' in keys, 'Missing header_key in prod.keys')
+    raw = read_at(f, offset, 0xc00)
+    hdr = b''.join(decrypt(keys['header_key'], modes.XTS(i.to_bytes(16, 'big')),
+                           raw[i * 512:(i + 1) * 512]) for i in range(6))
+    require(hdr[0x200:0x204] == b'NCA3', 'Expected NCA3 (check prod.keys and the game file)')
+    require(struct.unpack_from('<Q', hdr, 0x208)[0] == size, 'NCA size does not match container entry')
+    for i in range(4):
+        start, end = struct.unpack_from('<II', hdr, 0x240 + i * 16)
+        require((start == end == 0) or 0xc00 <= start * 512 < end * 512 <= size, 'NCA section out of bounds')
+    return hdr
+
+
+def nca_ctr_key(hdr, keys, tickets):
+    generation = max(max(hdr[0x206], hdr[0x220]) - 1, 0)
+    rights = hdr[0x230:0x240]
+    if rights != bytes(16):
+        require(rights in tickets, 'Missing common ticket for rights-managed NCA in the NSP')
+        keyname = f'titlekek_{generation:02x}'
+        require(keyname in keys, f'Missing {keyname} in prod.keys')
+        return decrypt(keys[keyname], modes.ECB(), tickets[rights])
+    require(hdr[0x207] < 3, 'Unsupported NCA key area')
+    area = ('application', 'ocean', 'system')[hdr[0x207]]
+    keyname = f'key_area_key_{area}_{generation:02x}'
+    require(keyname in keys, f'Missing {keyname} in prod.keys')
+    return decrypt(keys[keyname], modes.ECB(), hdr[0x300:0x340])[32:48]
+
+
+def nca_inventory(f, entries, keys):
+    records = []
+    for name, offset, length in entries:
+        if not name.lower().endswith('.nca'):
+            continue
+        hdr = read_nca_header(f, offset, length, keys)
+        record = dict(name=name, nca_offset=offset, size=length, content_type=hdr[0x205],
+                      title_id=f'{struct.unpack_from("<Q", hdr, 0x210)[0]:016X}')
+        records.append((record, hdr))
+    return records
+
+
+def program_nca(records, update=False):
+    if update:
+        programs = [(r, h) for r, h in records if r["content_type"] == 0]
+        require(len(programs) == 1, "Expected one update Program NCA; combined packages are unsupported")
+        record, hdr = programs[0]
+        require(record["title_id"] == BASE_TITLE, "Update belongs to another game")
+        require(any(hdr[0x400 + i*512 + 4] == 4 for i in range(4)), "Expected a BKTR update, not a base game")
+        require(all(r["title_id"] in (BASE_TITLE, UPDATE_TITLE) for r, _ in records), "Mixed-title update package")
+        return record, hdr
+    # Update Program NCAs can retain the base title ID; their Meta NCA carries the update ID.
+    metadata = [r for r, _ in records if r['content_type'] == 1]
+    require(len(metadata) <= 1 and all(r['title_id'] == BASE_TITLE for r in metadata),
+            'Expected base game metadata; updates, DLC and combined packages are unsupported')
+    programs = [(r, h) for r, h in records if r['content_type'] == 0]
+    require(len(programs) == 1, 'Expected one base Program NCA; updates, DLC and combined packages are unsupported')
+    record, hdr = programs[0]
+    require(record['title_id'] == BASE_TITLE,
+            'Expected Breath of the Wild base game; updates, DLC and other games are unsupported')
+    return record, hdr
+
+
+def record_offset(record):
+    # Read manifests produced before NSP support too.
+    return record['nca_offset'] if 'nca_offset' in record else record['xci_offset']
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('game', type=Path, help='base game (.xci or .nsp), or with --update the 1.9.0 update NSP')
+    parser.add_argument('--keys', required=True, type=Path)
+    parser.add_argument('--update', action='store_true', help='extract update code; caller must verify supported version hashes')
+    parser.add_argument('--output', required=True, type=Path)
+    args = parser.parse_args()
+    require(not args.output.exists(), 'Output already exists; choose a new directory')
+    keys = load_keys(args.keys)
+    with args.game.open('rb') as f:
+        kind, entries = container_entries(f, args.game.stat().st_size)
+        tickets = common_tickets(f, entries)
+        records = nca_inventory(f, entries, keys)
+        record, hdr = program_nca(records, update=args.update)
+        ctr_key = nca_ctr_key(hdr, keys, tickets)
+        for i in range(4):
+            start, end = struct.unpack_from('<II', hdr, 0x240 + 16 * i)
+            if not start:
+                continue
+            fs = hdr[0x400 + 512 * i:0x600 + 512 * i]
+            require(hashlib.sha256(fs).digest() == hdr[0x280 + 32 * i:0x2A0 + 32 * i], 'FS header hash mismatch')
+            if fs[2:4] != b'\x01\x02':
+                continue
+            require(fs[4] == 3, 'Only AES-CTR ExeFS is supported')
+            blocksize, levels = struct.unpack_from('<II', fs, 0x28)
+            hashoff, hashsize, pfsoff, pfssize = struct.unpack_from('<QQQQ', fs, 0x30)
+            secstart, secsize = start * 512, (end - start) * 512
+            require(levels == 2 and blocksize > 0 and pfssize <= 512 * 1024 * 1024, 'Unsupported ExeFS hash layout')
+
+            def section_read(relative, size):
+                require(relative >= 0 and relative + size <= secsize, 'Section read out of bounds')
+                absolute = secstart + relative
+                aligned = absolute & ~15
+                iv = fs[0x140:0x148][::-1] + (aligned // 16).to_bytes(8, 'big')
+                data = read_at(f, record_offset(record) + aligned, size + absolute - aligned)
+                return decrypt(ctr_key, modes.CTR(iv), data)[absolute - aligned:]
+
+            hashes = section_read(hashoff, hashsize)
+            require(hashlib.sha256(hashes).digest() == fs[8:40], 'ExeFS hash-table mismatch')
+            pfs = section_read(pfsoff, pfssize)
+            for index, pos in enumerate(range(0, pfssize, blocksize)):
+                expected = hashes[index * 32:(index + 1) * 32]
+                require(hashlib.sha256(pfs[pos:pos + blocksize]).digest() == expected,
+                        f'ExeFS block hash mismatch: {index}')
+            files = [(name, pfs[off:off + size]) for name, off, size in
+                     partition_entries(io.BytesIO(pfs), 0, len(pfs))]
+            require(any(name == 'main.npdm' for name, _ in files), 'PFS0 is not ExeFS')
+            args.output.mkdir(parents=True)
+            extracted = []
+            for name, data in files:
+                (args.output / name).write_bytes(data)
+                extracted.append({'name': name, 'size': len(data), 'sha256': hashlib.sha256(data).hexdigest()})
+            manifest = {'source': str(args.game.resolve()), 'source_size': args.game.stat().st_size,
+                        'source_mtime_ns': args.game.stat().st_mtime_ns, 'container': kind,
+                        'nca_inventory': [r for r, _ in records], 'program': record, 'section_index': i,
+                        'integrity': 'FS header, ExeFS hash table, and every ExeFS data block verified; RSA signatures not checked',
+                        'files': extracted}
+            (args.output.parent / 'extraction-manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
+            print(json.dumps({'integrity': manifest['integrity'], 'files': extracted}, indent=2))
+            return
+        raise ValueError('No ExeFS section found')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/games/botw/scripts/extract_romfs.py b/games/botw/scripts/extract_romfs.py
new file mode 100644
index 0000000..0b057be
--- /dev/null
+++ b/games/botw/scripts/extract_romfs.py
@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+"""Verify all six IVFC levels, stream a local RomFS image, and index its files."""
+import argparse
+import hashlib
+import json
+import struct
+from pathlib import Path
+from cryptography.hazmat.primitives.ciphers import modes
+from extract_exefs import (decrypt, read_at, require, load_keys, container_entries, common_tickets,
+                           nca_inventory, program_nca, nca_ctr_key, record_offset)
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--keys',type=Path,required=True)
+    parser.add_argument('--manifest',type=Path,default=Path('extracted/v0/extraction-manifest.json'))
+    parser.add_argument('--output',type=Path,default=Path('extracted/v0/romfs'))
+    args=parser.parse_args(); require(not args.output.exists(),'Output already exists')
+    manifest=json.loads(args.manifest.read_text());record=manifest['program'];keys=load_keys(args.keys)
+    source=Path(manifest['source']);require(source.stat().st_size==manifest['source_size'],'Source size changed')
+    with source.open('rb') as f:
+        _,entries=container_entries(f,source.stat().st_size)
+        actual,hdr=program_nca(nca_inventory(f,entries,keys))
+        require(actual['name']==record['name'] and actual['size']==record['size'] and
+                record_offset(actual)==record_offset(record),'Source Program NCA changed; extract ExeFS again')
+        ctr_key=nca_ctr_key(hdr,keys,common_tickets(f,entries))
+        for i in range(4):
+            start,end=struct.unpack_from('<II',hdr,0x240+i*16)
+            if not start:continue
+            fs=hdr[0x400+512*i:0x600+512*i]
+            require(hashlib.sha256(fs).digest()==hdr[0x280+32*i:0x2a0+32*i],'FS header hash')
+            if fs[2:5]!=bytes([0,3,3]):continue
+            require(fs[8:12]==b'IVFC' and struct.unpack_from('<III',fs,12)==(0x20000,32,7),'Unsupported IVFC layout')
+            levels=[struct.unpack_from('<QQII',fs,0x18+j*24) for j in range(6)]
+            def read(relative,size):
+                require(0<=relative<=relative+size<=(end-start)*512,'Section bounds')
+                absolute=start*512+relative;aligned=absolute&~15;skip=absolute-aligned
+                iv=fs[0x140:0x148][::-1]+(aligned//16).to_bytes(8,'big')
+                return decrypt(ctr_key,modes.CTR(iv),read_at(f,record_offset(record)+aligned,size+skip))[skip:]
+            args.output.mkdir(parents=True);image_path=args.output/'romfs.bin';digest=hashlib.sha256();counts=[]
+            parent=fs[0xc8:0xe8]
+            with image_path.open('wb') as image:
+                for level,(offset,size,power,reserved) in enumerate(levels):
+                    require(12<=power<=24 and reserved==0,'IVFC block size');block=1<<power
+                    require(len(parent)>=(size+block-1)//block*32,'IVFC parent size')
+                    captured=bytearray() if level<5 else None
+                    index=0
+                    for pos in range(0,size,8*1024*1024):
+                        chunk=read(offset+pos,min(8*1024*1024,size-pos))
+                        for j in range(0,len(chunk),block):
+                            payload=chunk[j:j+block]
+                            require(hashlib.sha256(payload+bytes(block-len(payload))).digest()==parent[index*32:index*32+32],f'IVFC level {level} block {index} failed')
+                            index+=1
+                        if captured is not None:captured.extend(chunk)
+                        else:image.write(chunk);digest.update(chunk)
+                    counts.append(index)
+                    if captured is not None:parent=bytes(captured)
+                    print(f'IVFC level {level}: {index} blocks verified',flush=True)
+            files=index_romfs(image_path)
+            report=dict(status='pass',source_size=source.stat().st_size,program=record['name'],section=i,ivfc_blocks=counts,romfs_size=levels[-1][1],romfs_sha256=digest.hexdigest(),files=files,integrity='FS header and all six IVFC levels verified; RSA signature not checked')
+            (args.output/'index.json').write_text(json.dumps(report,indent=2)+'\n')
+            print(json.dumps(dict(status='pass',file_count=len(files),size=levels[-1][1],sha256=digest.hexdigest())),flush=True);return
+    raise ValueError('No supported RomFS found')
+
+def index_romfs(path):
+    with path.open('rb') as f:
+        h=struct.unpack('<10Q',read_at(f,0,80));require(h[0]==80,'RomFS header');length=path.stat().st_size
+        for off,size in [(h[1],h[2]),(h[3],h[4]),(h[5],h[6]),(h[7],h[8])]:require(off+size<=length,'RomFS table bounds')
+        dirs=read_at(f,h[3],h[4]);entries=read_at(f,h[7],h[8]);files=[];seen_dirs=set();seen_files=set();paths=set()
+        def name(table,off,n):
+            require(off+n<=len(table),'Name bounds');s=table[off:off+n].decode('utf-8');require(s not in ['.','..'] and '/' not in s and '\\' not in s and '\0' not in s,'Unsafe path');return s
+        todo=[(0,'')]
+        while todo:
+            off,parent=todo.pop();require(off not in seen_dirs and off+24<=len(dirs),'Invalid/cyclic directory');seen_dirs.add(off)
+            p,sibling,child,file,hash_next,n=struct.unpack_from('<6I',dirs,off);part=name(dirs,off+24,n);prefix=parent+part+'/' if part else parent
+            if sibling!=0xffffffff:todo.append((sibling,parent))
+            if child!=0xffffffff:todo.append((child,prefix))
+            while file!=0xffffffff:
+                require(file not in seen_files and file+32<=len(entries),'Invalid/cyclic file');seen_files.add(file)
+                p,next_file,data,size,hash_next,n=struct.unpack_from('<IIQQII',entries,file);part=name(entries,file+32,n);require(part!='','Empty file name');filename=prefix+part
+                require(filename not in paths and h[9]+data+size<=length,'Duplicate/out-of-bounds file');paths.add(filename)
+                files.append(dict(path=filename,offset=h[9]+data,size=size));file=next_file
+        return sorted(files,key=lambda item:item['path'])
+if __name__=='__main__':main()
diff --git a/games/botw/scripts/extract_update_romfs.py b/games/botw/scripts/extract_update_romfs.py
new file mode 100644
index 0000000..ddd9a6c
--- /dev/null
+++ b/games/botw/scripts/extract_update_romfs.py
@@ -0,0 +1,114 @@
+#!/usr/bin/env python3
+"""Merge a base XCI/NSP and an update NSP with the pinned hactool BKTR reader.
+
+Temporary common-ticket keys are private files, never arguments or log output.
+The caller additionally verifies the resulting image against its known version hash.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+from extract_exefs import (load_keys, container_entries, common_tickets, nca_inventory,
+                           program_nca, record_offset, require)
+from extract_romfs import index_romfs
+from romfs_damage import ALLOWED, KNOWN_DAMAGE_MESSAGE, judge
+
+
+def copy_range(source, offset, size, target):
+    with source.open('rb') as src, target.open('wb') as dst:
+        src.seek(offset)
+        while size:
+            data = src.read(min(size, 8 << 20))
+            require(bool(data), 'Truncated NCA')
+            dst.write(data)
+            size -= len(data)
+
+
+def merge(base, update, keys_path, hactool, output, *, base_romfs=None):
+    require(not output.exists(), 'Output exists')
+    keys = load_keys(keys_path)
+    inputs = []
+    tickets = {}
+    sources = ((update, True),) if base_romfs else ((base, False), (update, True))
+    for source, is_update in sources:
+        with source.open('rb') as f:
+            kind, entries = container_entries(f, source.stat().st_size)
+            require(not is_update or kind == 'nsp', 'Update must be an NSP')
+            found = common_tickets(f, entries)
+            for rights, key in found.items():
+                require(rights not in tickets or tickets[rights] == key, 'Conflicting common tickets')
+                tickets[rights] = key
+            record, header = program_nca(nca_inventory(f, entries, keys), update=is_update)
+            rights = header[0x230:0x240]
+            require(rights == bytes(16) or rights in tickets, 'Missing common ticket')
+            inputs.append((source, record, header))
+    sections = [i for i in range(4) if inputs[-1][2][0x400+i*512+4] == 4]
+    require(len(sections) == 1, 'Expected one BKTR section')
+    output.parent.mkdir(parents=True, exist_ok=True)
+    require(shutil.disk_usage(output.parent).free > inputs[-1][1]['size'] + 18*(1 << 30),
+            'Need about 19 GiB free for the temporary update NCA and merged image')
+    if base_romfs:
+        require(Path(base_romfs).is_file(), 'Previous-version RomFS is missing')
+    with tempfile.TemporaryDirectory(prefix='update-merge-', dir=output.parent) as tmp:
+        tmp = Path(tmp)
+        keyfile = tmp/'title.keys'
+        fd = os.open(keyfile, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+        with os.fdopen(fd, 'w') as f:
+            for rights, key in tickets.items():
+                f.write(f'{rights.hex()} = {key.hex()}\n')
+        source, record, _ = inputs[-1]
+        copy_range(source, record_offset(record), record['size'], tmp/'update.nca')
+        result = tmp/'result'
+        result.mkdir()
+        base_arg = '--baseromfs='+str(Path(base_romfs).resolve()) if base_romfs else '--basenca='+str(base.resolve())
+        environment = dict(os.environ, MNG_TITLE_KEYS=str(keyfile))
+        environment.pop('MNG_BASE_RANGE_OFFSET', None); environment.pop('MNG_BASE_RANGE_SIZE', None)
+        if not base_romfs:
+            environment.update(MNG_BASE_RANGE_OFFSET=str(record_offset(inputs[0][1])),
+                               MNG_BASE_RANGE_SIZE=str(inputs[0][1]['size']))
+        command = [str(hactool.resolve()), '-x', '-y', '--disablekeywarns', '--suppresskeys',
+                   '-k', str(keys_path.resolve()), base_arg,
+                   f'--section{sections[0]}='+str(result/'romfs.bin'), str(tmp/'update.nca')]
+        with (result/'merge.log').open('w') as log:
+            code = subprocess.run(command, env=environment,
+                                  stdout=log, stderr=subprocess.STDOUT).returncode
+        log = (result/'merge.log').read_text()
+        if code or re.search(r'\(FAIL\)|\(INVALID\)|Failed to|Error:', log):
+            (output.parent/(output.name+'-failure.log')).write_text(log)
+        require(code == 0 and not re.search(r'Failed to|Error:', log), 'BKTR merge failed')
+        # Only the RomFS data level may fail, and only inside the one tolerated file (romfs_damage.py).
+        require(all(re.search(rf'Level {i} \(GOOD\)', log) for i in range(5)), 'IVFC hash tree did not verify')
+        require(not re.search(r'\(INVALID\)', log) and len(re.findall(r'\(FAIL\)', log)) <= 1, 'BKTR verification failed')
+        image = result/'romfs.bin'
+        files = index_romfs(image)
+        integrity = 'BKTR merge; all six IVFC levels verified'
+        if not re.search(r'Level 5 \(GOOD\)', log):
+            require('Level 5 (FAIL)' in log and 'MNG_BADBLOCK' in log, 'Missing verified IVFC levels')
+            verdict = judge(log, [(f['path'], f['offset'], f['size']) for f in files])
+            require(verdict.ok, 'RomFS damage outside the tolerated file, replace the update package: ' + ', '.join(verdict.offending[:20]))
+            integrity = 'BKTR merge; hash tree verified; data damage only inside ' + ALLOWED
+            print('WARNING: ' + KNOWN_DAMAGE_MESSAGE, flush=True)
+        with image.open('rb') as f:
+            digest = hashlib.file_digest(f, 'sha256').hexdigest()
+        report = dict(status='pass', romfs_size=image.stat().st_size, romfs_sha256=digest,
+                      files=files, integrity=integrity)
+        (result/'index.json').write_text(json.dumps(report, indent=2)+'\n')
+        result.rename(output)
+    print(json.dumps(dict(status='pass', files=len(files), sha256=digest)))
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('base', type=Path)
+    parser.add_argument('update', type=Path)
+    parser.add_argument('--keys', required=True, type=Path)
+    parser.add_argument('--hactool', required=True, type=Path)
+    parser.add_argument('--base-romfs', type=Path, help='full decrypted base IVFC section, including hash levels (not a raw RomFS image)')
+    parser.add_argument('--output', required=True, type=Path)
+    args = parser.parse_args()
+    merge(args.base, args.update, args.keys, args.hactool, args.output, base_romfs=args.base_romfs)
