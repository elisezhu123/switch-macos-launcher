+/* BOTW 1.9.0 baseline: no game-code patches yet. The game runs at its shipping speed and output size.
+   Frame-rate and output-size patches need BOTW-specific sites (see games/botw/README.md) and are added only after
+   each site is located and its original instruction words are asserted. */
+#include "game_patches.h"
+#include "game_version.h"
+#include <stdio.h>
+#include <string.h>
+
+void runtime_frame_step_pin(double ms) { (void)ms; fprintf(stderr, "[totk] BOTW 1.9.0: frame step is not patched\n"); }
+void runtime_frame_step_update(uint64_t now_ns) { (void)now_ns; }
+
+void runtime_game_patches(Module *m) {
+    if (strcmp(m->name, "main")) runtime_fail("BOTW game patches expect main");
+    fprintf(stderr, "[totk] BOTW 1.9.0: no game patches applied (shipping behaviour)\n");
+}
+
+int runtime_output_res(unsigned *w, unsigned *h) { (void)w; (void)h; return 0; }
+uint64_t runtime_output_res_extra_bytes(void) { return 0; }
+int runtime_output_res_toggle(void) { return 0; }
+int runtime_output_mode_cycle(void) { return 0; }
