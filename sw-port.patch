+#!/bin/bash
+# Out-of-tree compile of the BOTW 1.9.0 loader; mirrors the Makefile's build/totk-native-v143 rule. Compile + link only, never runs the game.
+# Usage: build_native.sh <data-root> <output-dir> <fonts-config-dir>
+#   data-root: holds build/v190/runtime_tables.h and romfs_config.h (scripts/prepare_runtime.py and prepare_romfs_backend.py, --version v190 --data-root)
+#   output-dir: receives gfx objects and botw-native-v190 (keep it outside the repository)
+#   fonts-config-dir: directory containing shared_fonts_config.h (scripts/prepare_shared_fonts.py; firmware shared fonts are game independent)
+set -e
+G="$(cd "$(dirname "$0")/../../totk" && pwd)"
+DATA="$(cd "$1" && pwd)"; O="$2"; FONTS="$(cd "$3" && pwd)"
+[ -n "$O" ] || { echo 'usage: build_native.sh <data-root> <output-dir> <fonts-config-dir>'; exit 2; }
+mkdir -p "$O/gfx"; O="$(cd "$O" && pwd)"
+cd $G
+GFX_FLAGS="-std=gnu11 -Wno-error -Wno-unused-function -Wno-unused-parameter -fobjc-arc -Ithird_party/d2r_gfx/gfx/nvn/include"
+OBJS=()
+for src in third_party/d2r_gfx/gfx/nvn/*.c third_party/d2r_gfx/gfx/nvn/*.m third_party/d2r_gfx/gfx/nvn/*.S third_party/d2r_gfx/gfx/tex/*.c third_party/d2r_gfx/gfx/tex/*.m; do
+  [ -f "$src" ] || continue
+  obj=$O/gfx/$(echo "$src" | tr '/' '_').o
+  if [ ! -f "$obj" ] || [ "$src" -nt "$obj" ]; then xcrun clang -O2 -g -Wall -Wextra $GFX_FLAGS -c "$src" -o "$obj"; fi
+  OBJS+=("$obj")
+done
+echo "gfx objects: ${#OBJS[@]}"
+xcrun clang -std=c11 -O2 -g -Wall -Wextra -Werror -Wno-deprecated-declarations -Ithird_party/d2r_gfx/gfx/nvn/include -DTOTK_GAME_V190=1 \
+ -I"$DATA/build/v190" -I"$FONTS" -I/opt/homebrew/opt/opus/include/opus -I/opt/homebrew/opt/libvpx/include \
+ runtime/loader.c runtime/game_patches_v190.c runtime/world_survey.c runtime/game_slot.c runtime/services.c runtime/romfs.c runtime/romfs_mods.c runtime/threads.c runtime/gate.S runtime/hle_stack.S runtime/hle_stack.c runtime/thread_enter.S runtime/gfx_bridge.c runtime/frontend.m runtime/account.c runtime/input.c runtime/hid_feedback.c runtime/motion_fusion.c runtime/autoload.c runtime/gamepad.m runtime/gamepad_feedback.m runtime/gfx_probe.c runtime/vpool_probe.m runtime/gpu_path_probe.m runtime/memory_probe.c runtime/shared_font.c runtime/ipc.c runtime/audio_renderer.c runtime/audio_mixer.c runtime/audio_reverb.c runtime/fs_host.c runtime/opus_codec.c runtime/movie_host.c runtime/time_host.c runtime/applet_host.c runtime/swkbd_host.c \
+ "${OBJS[@]}" /opt/homebrew/opt/opus/lib/libopus.a /opt/homebrew/opt/libvpx/lib/libvpx.a \
+ -framework Metal -framework MetalFX -framework Foundation -framework QuartzCore -framework ImageIO -framework CoreGraphics -framework CoreText -framework UniformTypeIdentifiers -fobjc-arc -framework Cocoa -framework CoreVideo -framework CoreFoundation -framework AudioToolbox -framework GameController -framework CoreHaptics -framework IOKit -framework CoreHaptics \
+ -o $O/botw-native-v190
+echo BUILD_OK
diff --git a/games/botw/scripts/extract_exefs.py b/games/botw/scripts/extract_exefs.py
