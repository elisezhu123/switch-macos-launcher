new file mode 100644
index 0000000..822eec1
--- /dev/null
+++ b/games/totk/runtime/romfs_mods.c
@@ -0,0 +1,110 @@
+/* See romfs_mods.h. */
+#include "romfs_mods.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static int path_inside(const char *p) {   /* relative, no empty / . / .. components, no backslash */
+    if (!*p || *p == '/' || strchr(p, '\\')) return 0;
+    for (const char *s = p; *s;) {
+        const char *e = strchr(s, '/'); size_t n = e ? (size_t)(e - s) : strlen(s);
+        if (!n || (n == 1 && s[0] == '.') || (n == 2 && s[0] == '.' && s[1] == '.')) return 0;
+        s += n; if (*s) s++; else break;
+        if (!*s) return 0;   /* trailing slash */
+    }
+    return 1;
+}
+static int by_path(const void *a, const void *b) { return strcmp(((const mods_entry *)a)->path, ((const mods_entry *)b)->path); }
+static int by_index(const void *a, const void *b) {
+    uint64_t x = ((const mods_bound_entry *)a)->index, y = ((const mods_bound_entry *)b)->index; return x < y ? -1 : x > y;
+}
+
+void mods_free(mods_t *m) {
+    for (size_t i = 0; i < m->n; i++) { free(m->v[i].path); free(m->v[i].host); }
+    free(m->v); m->v = NULL; m->n = 0;
+}
+
+int mods_parse(const char *text, size_t len, mods_t *out, char *err, size_t errlen) {
+    out->v = NULL; out->n = 0; size_t cap = 0, line = 0;
+    for (size_t at = 0; at < len;) {
+        const char *s = text + at, *nl = memchr(s, '\n', len - at); size_t n = nl ? (size_t)(nl - s) : len - at;
+        at += n + 1; line++;
+        if (n && s[n - 1] == '\r') n--;
+        if (!n) continue;
+        const char *t1 = memchr(s, '\t', n), *t2 = t1 ? memchr(t1 + 1, '\t', n - (size_t)(t1 + 1 - s)) : NULL;
+        char size_text[24]; size_t sl = t2 ? n - (size_t)(t2 + 1 - s) : 0;
+        if (!t1 || !t2 || t1 == s || t2 == t1 + 1 || !sl || sl >= sizeof size_text || memchr(t2 + 1, '\t', sl)) {
+            snprintf(err, errlen, "mods manifest line %zu: expected <RomFS path>\\t<host path>\\t<size>", line); mods_free(out); return 1; }
+        memcpy(size_text, t2 + 1, sl); size_text[sl] = 0;
+        char *end; errno = 0; unsigned long long size = strtoull(size_text, &end, 10);
+        if (*end || errno || size_text[0] == '-') { snprintf(err, errlen, "mods manifest line %zu: bad size", line); mods_free(out); return 1; }
+        char *path = strndup(s, (size_t)(t1 - s)), *host = strndup(t1 + 1, (size_t)(t2 - t1 - 1));
+        if (!path || !host || !path_inside(path) || host[0] != '/') {
+            snprintf(err, errlen, "mods manifest line %zu: the RomFS path must be relative and inside the game, the host path absolute", line);
+            free(path); free(host); mods_free(out); return 1; }
+        if (out->n == cap) { cap = cap ? cap * 2 : 64; mods_entry *v = realloc(out->v, cap * sizeof *v); if (!v) { free(path); free(host); mods_free(out); snprintf(err, errlen, "out of memory"); return 1; } out->v = v; }
+        out->v[out->n++] = (mods_entry){path, host, size};
+    }
+    /* Sort by path keeping manifest order within a path (mergesort is stable), then keep the last line of each path. */
+    if (out->n && mergesort(out->v, out->n, sizeof *out->v, by_path)) { snprintf(err, errlen, "out of memory"); mods_free(out); return 1; }
+    size_t w = 0;
+    for (size_t i = 0; i < out->n; i++) {
+        if (i + 1 < out->n && !strcmp(out->v[i].path, out->v[i + 1].path)) { free(out->v[i].path); free(out->v[i].host); continue; }
+        out->v[w++] = out->v[i];
+    }
+    out->n = w;
+    return 0;
+}
+
+const mods_entry *mods_find(const mods_t *m, const char *romfs_path) {
+    mods_entry key = {(char *)romfs_path, NULL, 0};
+    return m->n ? bsearch(&key, m->v, m->n, sizeof *m->v, by_path) : NULL;
+}
+
+void mods_bound_free(mods_bound_t *b) {
+    for (size_t i = 0; i < b->n; i++) if (b->v[i].fd >= 0) close(b->v[i].fd);
+    free(b->v); b->v = NULL; b->n = 0;
+}
+
+int mods_bind(const mods_t *m, int64_t (*find_index)(const char *path, void *ctx), int (*builtin)(uint64_t index, void *ctx),
+              void *ctx, void (*log)(const char *line, void *ctx), void *log_ctx, mods_bound_t *out, char *err, size_t errlen) {
+    out->v = m->n ? calloc(m->n, sizeof *out->v) : NULL; out->n = 0;
+    if (m->n && !out->v) { snprintf(err, errlen, "out of memory"); return 1; }
+    char line[1200];
+    for (size_t i = 0; i < m->n; i++) {
+        const mods_entry *e = &m->v[i];
+        int64_t index = find_index(e->path, ctx);
+        if (index < 0) { snprintf(line, sizeof line, "mod: %s not in the game (new files are not supported)", e->path); log(line, log_ctx); continue; }
+        if (builtin(index, ctx)) { snprintf(line, sizeof line, "mod: %s ignored (built-in fix)", e->path); log(line, log_ctx); continue; }
+        int fd = open(e->host, O_RDONLY | O_CLOEXEC); struct stat st;
+        if (fd < 0 || fstat(fd, &st) || !S_ISREG(st.st_mode) || (uint64_t)st.st_size != e->size) {
+            if (fd >= 0) close(fd);
+            snprintf(err, errlen, "mod file changed since the launcher listed it: %s (%s)", e->path, e->host);
+            mods_bound_free(out); return 1; }
+        out->v[out->n++] = (mods_bound_entry){(uint64_t)index, e->size, fd};
+    }
+    qsort(out->v, out->n, sizeof *out->v, by_index);
+    return 0;
+}
+
+const mods_bound_entry *mods_bound_find(const mods_bound_t *b, uint64_t index) {
+    mods_bound_entry key = {index, 0, -1};
+    return b->n ? bsearch(&key, b->v, b->n, sizeof *b->v, by_index) : NULL;
+}
+
+int mods_manifest_check(const char *text, size_t len, char *err, size_t errlen) {
+    mods_t m;
+    if (mods_parse(text, len, &m, err, errlen)) return 1;
+    for (size_t i = 0; i < m.n; i++) {
+        struct stat st;
+        if (stat(m.v[i].host, &st) || !S_ISREG(st.st_mode) || (uint64_t)st.st_size != m.v[i].size) {
+            snprintf(err, errlen, "mod file changed since the launcher listed it: %s (%s)", m.v[i].path, m.v[i].host);
+            mods_free(&m); return 1; }
+    }
+    mods_free(&m);
+    return 0;
+}
diff --git a/games/totk/runtime/romfs_mods.h b/games/totk/runtime/romfs_mods.h
new file mode 100644
index 0000000..c9e1e09
--- /dev/null
+++ b/games/totk/runtime/romfs_mods.h
@@ -0,0 +1,29 @@
+/* RomFS mods: files the launcher lists in a manifest replace the game's files of the same RomFS path.
+   The manifest (TOTK_MODS_MANIFEST, written by sw-launcher before each start) is UTF-8 text, one file per line:
+   <RomFS path>\t<absolute host path>\t<size in bytes>. A later line for the same path wins (the launcher writes mods in
+   load order). Mod files are not hashed; their size is checked once at start, so a file changed after the launcher listed
+   it stops the start instead of being read half-way. */
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct { char *path, *host; uint64_t size; } mods_entry;
+typedef struct { mods_entry *v; size_t n; } mods_t;                     /* sorted by path, one entry per path */
+typedef struct { uint64_t index, size; int fd; } mods_bound_entry;
+typedef struct { mods_bound_entry *v; size_t n; } mods_bound_t;         /* sorted by RomFS file index */
+
+int mods_parse(const char *text, size_t len, mods_t *out, char *err, size_t errlen);
+const mods_entry *mods_find(const mods_t *m, const char *romfs_path);
+void mods_free(mods_t *m);
+
+/* Opens the mod files that replace files the game has. find_index returns the RomFS file index of a path or -1; builtin
+   says whether a built-in fix already replaces that file (it wins). Skipped files are reported through log. Returns 0, or
+   non-zero with err set (a mod file is missing or its size changed). */
+int mods_bind(const mods_t *m, int64_t (*find_index)(const char *path, void *ctx), int (*builtin)(uint64_t index, void *ctx),
+              void *ctx, void (*log)(const char *line, void *ctx), void *log_ctx, mods_bound_t *out, char *err, size_t errlen);
+const mods_bound_entry *mods_bound_find(const mods_bound_t *b, uint64_t index);
+void mods_bound_free(mods_bound_t *b);
+
+/* For the in-app launcher before it starts the game: parses the manifest and checks that every listed host file still
+   exists with the listed size. Returns 0, or non-zero with err set. */
+int mods_manifest_check(const char *text, size_t len, char *err, size_t errlen);
