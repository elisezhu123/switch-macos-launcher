+++ b/tests/test_botw_build_args.py
@@ -0,0 +1,50 @@
+"""Argument handling of the BOTW build entry (no game files needed)."""
+from pathlib import Path
+import sys
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+sys.path.insert(0, str(ROOT / 'games/botw/scripts'))
+
+import build_app  # noqa: E402
+import build_botw  # noqa: E402
+
+
+class BotwBuildArgs(unittest.TestCase):
+    def test_update_required(self):
+        with self.assertRaises(SystemExit) as raised:
+            build_botw.parse_args(['b.nsp', '-k', 'k'])
+        self.assertIn('BOTW needs the 1.9.0 update', str(raised.exception))
+
+    def test_title_routes_to_botw(self):
+        args = build_app.parse_args(['--title', 'botw', 'b.nsp', '--update', 'u.nsp', '-k', 'k'])
+        self.assertEqual(args.title, 'botw')
+
+    def test_default_title_is_totk(self):
+        args = build_app.parse_args(['g.xci', '-k', 'k'])
+        self.assertEqual(args.title, 'totk')
+
+
+if __name__ == '__main__':
+    unittest.main()
+
+
+class BotwErrors(unittest.TestCase):
+    def test_botw_error_is_one_line(self):
+        """build_app.py run as a script must turn a BOTW BuildError into its one-line ERROR, not a traceback."""
+        import subprocess, tempfile
+        with tempfile.TemporaryDirectory() as d:
+            r = subprocess.run([sys.executable, str(ROOT / 'build_app.py'), '--title', 'botw', f'{d}/missing.nsp',
+                                '--update', f'{d}/u.nsp', '-k', f'{d}/k'], capture_output=True, text=True)
+        self.assertEqual(r.returncode, 1, r.stderr)
+        self.assertIn('ERROR: no such file', r.stderr)
+        self.assertNotIn('Traceback', r.stderr)
+
+
+class AppInfo(unittest.TestCase):
+    def test_apps_declare_mods_support(self):
+        """sw-launcher tells a pre-mods app (no SWModsManifest key) from a new one."""
+        self.assertEqual(build_app.APP_INFO_EXTRA, {'SWModsManifest': True})
+        self.assertIn('**B.APP_INFO_EXTRA', (ROOT / 'games/botw/scripts/build_botw.py').read_text())
+        self.assertIn('**APP_INFO_EXTRA', (ROOT / 'build_app.py').read_text())
diff --git a/tests/test_botw_romfs_damage.py b/tests/test_botw_romfs_damage.py
new file mode 100644
index 0000000..af8a7ec
--- /dev/null
+++ b/tests/test_botw_romfs_damage.py
@@ -0,0 +1,45 @@
+"""The one tolerated damage in the BOTW 1.9.0 RomFS (no game files needed)."""
+from pathlib import Path
+import sys
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'games/botw/scripts'))
+from romfs_damage import ALLOWED, check_damage, parse_bad_blocks  # noqa: E402
+
+FILES = [('Actor/Pack/X.sbactorpack', 0x1000, 0x8000), (ALLOWED, 0x10000, 0x140000), ('Pack/Bootup.pack', 0x150000, 0x4000)]
+
+
+class Damage(unittest.TestCase):
+    def test_no_damage(self):
+        v = check_damage([], FILES)
+        self.assertEqual((v.ok, v.known, v.offending), (True, False, []))
+
+    def test_known_damage_only(self):
+        v = check_damage([(0x20000, 0x24000), (0x24000, 0x28000)], FILES)
+        self.assertEqual((v.ok, v.known, v.offending), (True, True, []))
+
+    def test_damage_elsewhere(self):
+        v = check_damage([(0x2000, 0x3000)], FILES)
+        self.assertEqual((v.ok, v.offending), (False, ['Actor/Pack/X.sbactorpack']))
+
+    def test_mixed(self):
+        v = check_damage([(0x20000, 0x24000), (0x150000, 0x150010)], FILES)
+        self.assertEqual((v.ok, v.offending), (False, ['Pack/Bootup.pack']))
+
+    def test_damage_outside_any_file(self):
+        v = check_damage([(0x0, 0x200)], FILES)
+        self.assertEqual((v.ok, v.offending), (False, ['<RomFS metadata>']))
+
+    def test_parse_hactool_log(self):
+        log = ('MNG_BADBLOCK data_ofs=1c4c000 ofs=20000 len=4000 src=PATCH\n'
+               'MNG_BADBLOCK data_ofs=1c4c000 ofs=24000 len=4000 src=BASE\n'
+               'MNG_BADBLOCK data_ofs=c000 ofs=0 len=4000 src=PATCH\n'
+               '        Level 5 (FAIL):\n            Data Offset:            0x000001c4c000\n')
+        blocks = parse_bad_blocks(log)
+        self.assertEqual(blocks.data, [(0x20000, 0x24000)])
+        self.assertEqual(blocks.base_data, [(0x24000, 0x28000)])
+        self.assertTrue(blocks.hash_tree)
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/tests/test_launcher_names.py b/tests/test_launcher_names.py
new file mode 100644
index 0000000..83bae90
--- /dev/null
+++ b/tests/test_launcher_names.py
@@ -0,0 +1,39 @@
+"""The in-app launcher (games/totk/app/launcher.m) uses each game's own folders and binary."""
+from pathlib import Path
+import re
+import subprocess
+import unittest
+
+GAME = Path(__file__).resolve().parents[1] / 'games/totk'
+
+
+def preprocess(*defines):
+    r = subprocess.run(['xcrun', 'clang', '-E', '-P', '-x', 'objective-c', '-Ithird_party/d2r_gfx/gfx/nvn', '-Iruntime', *defines,
+                        'app/launcher.m'], cwd=GAME, capture_output=True, text=True)
+    if r.returncode:
+        raise AssertionError(r.stderr)
+    text = r.stdout[r.stdout.index('int main('):]
+    return re.sub(r'"\s*@?"', '', text)   # join adjacent string literals as the compiler does
+
+
+class LauncherNames(unittest.TestCase):
+    def test_botw(self):
+        text = preprocess('-DTOTK_GAME_V190=1')
+        self.assertIn('MacNativeGames/BOTW', text)
+        self.assertIn('botw.log', text)
+        self.assertIn('build/botw-native', text)
+        self.assertNotIn('"TOTK"', text)
+        self.assertNotIn('MacNativeGames/TOTK', text)
+        self.assertIn('TOTK_MODS_MANIFEST', text)
+
+    def test_totk_unchanged(self):
+        for defines in ((), ('-DTOTK_GAME_V143=1',)):
+            text = preprocess(*defines)
+            self.assertIn('MacNativeGames/TOTK', text)
+            self.assertIn('totk.log', text)
+            self.assertIn('build/totk-native', text)
+            self.assertIn('TOTK_MODS_MANIFEST', text)
+
+
+if __name__ == '__main__':
+    unittest.main()
