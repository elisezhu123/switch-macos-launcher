diff -urN a/games/totk/tools/bake_metallibs.py b/games/totk/tools/bake_metallibs.py
--- a/games/totk/tools/bake_metallibs.py	1970-01-01 08:00:00
+++ b/games/totk/tools/bake_metallibs.py	2026-10-20 21:50:29
@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+"""Bake the translated shader sources (<key>.metal) of a shader cache directory into <key>.metallib next to them.
+
+The game compiles each translated shader from MSL source at run time; macOS keeps the result in a small shared system cache
+that other Metal programs can evict, and a cold start then costs minutes. A library baked here is a plain file the game loads
+in milliseconds and nothing else can evict it. It needs Apple's Metal Toolchain (xcodebuild -downloadComponent MetalToolchain).
+
+The options match totk_precise_opts() in nvn_mtl.m: MSL 4.1, safe math, default fp32 functions. metallib.sig records them; the
+game uses the baked libraries only while the stamp matches, so a change here must change RT_METALLIB_SIG there as well.
+
+    python3 games/totk/tools/bake_metallibs.py ~/Library/Application\\ Support/MacNativeGames/TOTK/shader-cache/rt-totk-native-v4-unverified
+"""
+import argparse
+import concurrent.futures
+import os
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+SIG = 'metal4.1;math=safe;fp32=fast'
+FLAGS = ['-std=metal4.1', '-fmetal-math-mode=safe']
+
+
+def bake_one(source: Path, out: Path, tmpdir: Path) -> str | None:
+    tmp = tmpdir / (out.name + f'.{os.getpid()}.tmp')
+    try:
+        proc = subprocess.run(['xcrun', '-sdk', 'macosx', 'metal', *FLAGS, '-o', str(tmp), str(source)],
+                              capture_output=True, text=True)
+        if proc.returncode or not tmp.is_file() or tmp.stat().st_size < 4:
+            return (proc.stderr or proc.stdout or 'no output').strip().splitlines()[0][:200] if (proc.stderr or proc.stdout) else 'no output'
+        if tmp.read_bytes()[:4] != b'MTLB':
+            return 'output is not a Metal library'
+        os.replace(tmp, out)   # same volume: readers never see a partial file
+        return None
+    finally:
+        tmp.unlink(missing_ok=True)
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument('cache_dir', type=Path, help='shader cache directory holding the <key>.metal files')
+    ap.add_argument('-j', '--jobs', type=int, default=min(8, max(1, (os.cpu_count() or 4) - 2)))
+    ap.add_argument('--limit', type=int, default=0, help='bake at most this many (testing)')
+    ap.add_argument('--force', action='store_true', help='rebake libraries that already exist')
+    args = ap.parse_args()
+    root = args.cache_dir.expanduser()
+    if not root.is_dir():
+        print(f'no such directory: {root}', file=sys.stderr)
+        return 2
+    if subprocess.run(['xcrun', '-sdk', 'macosx', 'metal', '--version'], capture_output=True).returncode:
+        print('the Metal Toolchain is missing: xcodebuild -downloadComponent MetalToolchain', file=sys.stderr)
+        return 2
+    sig_path = root / 'metallib.sig'
+    old = sig_path.read_text().strip() if sig_path.is_file() else None
+    if old != SIG:   # libraries built with other options must not be mixed in
+        for stale in root.glob('*.metallib'):
+            stale.unlink()
+        sig_path.write_text(SIG + '\n')
+    todo = [p for p in sorted(root.glob('*.metal')) if args.force or not p.with_suffix('.metallib').exists()]
+    if args.limit:
+        todo = todo[:args.limit]
+    total = len(todo)
+    print(f'{total} to bake ({len(list(root.glob("*.metal")))} sources), {args.jobs} at a time', flush=True)
+    failed, t0 = [], time.time()
+    with tempfile.TemporaryDirectory(prefix='.bake-', dir=root) as td, \
+            concurrent.futures.ThreadPoolExecutor(args.jobs) as pool:
+        futures = {pool.submit(bake_one, p, p.with_suffix('.metallib'), Path(td)): p for p in todo}
+        for n, fut in enumerate(concurrent.futures.as_completed(futures), 1):
+            error = fut.result()
+            if error:
+                failed.append((futures[fut].name, error))
+            if n % 200 == 0 or n == total:
+                print(f'  {n}/{total}  {time.time() - t0:.0f}s  failed {len(failed)}', flush=True)
+    for name, error in failed[:10]:
+        print(f'FAILED {name}: {error}', file=sys.stderr)
+    print(f'done: {total - len(failed)} baked, {len(failed)} failed, {time.time() - t0:.0f}s')
+    return 1 if failed else 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
